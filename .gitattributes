# 部署脚本需要在 Linux 上执行，强制 LF，避免 Windows 检出后  导致 bash 报错
*.sh text eol=lf

# 服务器配置模板保持 LF
deploy/*.service text eol=lf
deploy/*.conf text eol=lf
deploy/*.yml text eol=lf
deploy/gameplay.env.example text eol=lf

# 仓库规范与脚本换行符策略
.gitignore text eol=lf
*.sql text eol=lf
*.ps1 text eol=crlf
*.py text eol=lf
