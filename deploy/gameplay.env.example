# 生产环境变量模板：复制为 deploy/gameplay.env 并填入真实值（该文件已被 .gitignore 忽略）
# 服务器上的实际文件位置：/opt/gamemate/gameplay.env（权限 600）

# --- 数据库 ---
DB_USERNAME=gameplay
DB_PASSWORD=请填入强密码

# --- JWT 签名密钥（至少 32 字节，可用 openssl rand -hex 32 生成）---
JWT_SECRET=请填入随机密钥

# --- 前端来源（逗号分隔；同源 Nginx 部署时填公网地址与已绑定域名）---
APP_CORS_ALLOWED_ORIGINS=http://120.27.144.223,https://sknstse.cn,https://www.sknstse.cn

# --- 上传目录 ---
FILE_STORAGE_DIR=/opt/gamemate/uploads

# --- AI 客服模型（不填则由管理后台"AI 接口配置"页写入数据库）---
AI_MODEL_ENABLED=true
AI_MODEL_BASE_URL=https://token.sensenova.cn/v1
AI_MODEL_API_KEY=请填入模型 API Key
AI_MODEL_NAME=sensenova-6.8-flash-lite
